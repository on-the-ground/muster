{
  "version": 1,
  "pool": {
    "workers": 2,
    "queueLimit": 4
  },
  "correlation": {
    "metaKeys": [
      "subsea/callRef"
    ]
  },
  "backends": {
    "claude": {
      "kind": "claude",
      "executable": "claude"
    }
  },
  "tools": [
    {
      "name": "web-research",
      "description": "Research a question on the live web. Returns a summary, URL-cited evidence with observation dates, and uncertainties.",
      "version": "0.1.0",
      "inputSchema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "observedAt": {
                  "type": "string"
                }
              },
              "required": [
                "claim",
                "url",
                "observedAt"
              ],
              "additionalProperties": false
            }
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "summary",
          "evidence",
          "uncertainties"
        ],
        "additionalProperties": false
      },
      "instructions": {
        "version": "0.1.0",
        "text": "Research the question on the web with WebSearch and, where useful, WebFetch. Cite only URLs that appeared in your search results or that you fetched, with the date you observed them (UTC, ISO 8601). Report what you could not verify, including fetches that failed, under uncertainties; never present an unverified claim as evidence. Do not answer from memory alone. Return exactly the outputSchema object.",
        "sha256": "0cfc8405aedef4ab0efb7e303bd375c8d33a59ce3905303c56764dc67fe0be69"
      },
      "binding": {
        "backend": "claude",
        "extraction": "claude-structured-output",
        "context": []
      },
      "execution": {
        "permissions": "web-read",
        "effect": "external-read",
        "cancellation": "terminate-process-group",
        "reuseSession": false,
        "resources": "captured-context+web",
        "timeoutSeconds": 600
      }
    }
  ]
}
